# MOC control keys:
quit_client           = q
quit                  = Q

# Menu and interface control keys:
go                    = ENTER i
menu_down             = DOWN j
menu_up               = UP k
search_menu           = /
toggle_menu           = TAB h l v
theme_menu            = T
help                  = : ?
refresh               = ^r
reload                = r

# Audio playing and positioning keys:
seek_forward          = RIGHT m
seek_backward         = LEFT
pause                 = p SPACE ESCAPE
stop                  = s
next                  = n H
previous              = b L
toggle_shuffle        = S
toggle_repeat         = R
toggle_auto_next      = X

# Volume control keys:
volume_down_1         = <
volume_up_1           = >
volume_down_5         = ,
volume_up_5           = .
volume_10             = M-1
volume_20             = M-2
volume_30             = M-3
volume_40             = M-4
volume_50             = M-5
volume_60             = M-6
volume_70             = M-7
volume_80             = M-8
volume_90             = M-9

# Playlist specific keys:
add_file              = o
delete_from_playlist  = d
plist_move_up         = K
plist_move_down       = J
save_playlist         = V
clear_playlist        = D

